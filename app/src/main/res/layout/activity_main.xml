<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="me.robwilliams.pack.MainActivity"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="32sp"
        android:textColor="@color/home_accent"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="2"
        android:alignmentMode="alignBounds"
        android:useDefaultMargins="false">

        <!-- Row 1 -->

        <LinearLayout
            android:id="@+id/tile_lists"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/tile_background"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openListsActivity">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_home_lists"
                android:tint="@color/home_accent"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_activity_list_overview"
                android:textSize="13sp"
                android:textColor="@color/tile_text"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_sets"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/tile_background"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openSetsActivity">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_home_sets"
                android:tint="@color/home_accent"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_activity_set_overview"
                android:textSize="13sp"
                android:textColor="@color/tile_text"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_bags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/tile_background"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openBagsActivity">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_home_bags"
                android:tint="@color/home_accent"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_activity_bag_management"
                android:textSize="13sp"
                android:textColor="@color/tile_text"
                android:gravity="center" />
        </LinearLayout>

        <!-- Row 2 -->

        <LinearLayout
            android:id="@+id/tile_trips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/tile_background"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openTripsActivity">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_home_trips"
                android:tint="@color/home_accent"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_activity_trip_overview"
                android:textSize="13sp"
                android:textColor="@color/tile_text"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_cloud_backup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/tile_background"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openCloudBackup">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_home_cloud"
                android:tint="@color/home_accent"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cloud Backup"
                android:textSize="13sp"
                android:textColor="@color/tile_text"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_theme"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/tile_background"
            android:clickable="true"
            android:focusable="true"
            android:onClick="toggleTheme">

            <ImageView
                android:id="@+id/theme_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_home_theme"
                android:tint="@color/home_accent"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/theme_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_auto"
                android:textSize="13sp"
                android:textColor="@color/tile_text"
                android:gravity="center" />
        </LinearLayout>

    </GridLayout>

</LinearLayout>
