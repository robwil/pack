<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="me.robwilliams.pack.TripDetailActivity">
    <item android:id="@+id/action_search_trip_items"
        android:title="@string/action_search_trip_items"
        android:icon="@android:drawable/ic_menu_search"
        app:actionViewClass="androidx.appcompat.widget.SearchView"
        app:showAsAction="always|collapseActionView"
        android:orderInCategory="40" />
    <item android:id="@+id/action_manage_bags" android:title="@string/action_manage_trip_bags"
        android:orderInCategory="50" app:showAsAction="ifRoom"
        android:onClick="showTripBagSelection" />
    <item android:id="@+id/action_clear_repack" android:title="@string/action_clear_repack"
        android:orderInCategory="90" app:showAsAction="never"
        android:onClick="clearRepackItems" />
    <item android:id="@+id/action_copy_trip" android:title="@string/action_copy_trip"
        android:orderInCategory="100" app:showAsAction="never"
        android:onClick="showCopyTripDialog" />
    <item android:id="@+id/action_delete_trip" android:title="@string/action_delete_trip"
        android:orderInCategory="100" app:showAsAction="never"
        android:onClick="deleteTrip" />
</menu>
